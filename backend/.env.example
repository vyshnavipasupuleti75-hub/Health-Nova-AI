PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/health_nova_ai
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5175
GOOGLE_CLIENT_ID=
AI_PROVIDER=local
GEMINI_API_KEY=
# Report analysis + chatbot model. If Google reports a model as unavailable, set the model it recommends.
GEMINI_MODEL=gemini-flash-latest
# Web Push (health notifications + drink-water reminders). Generate with: npx web-push generate-vapid-keys
# Never commit the private key. VAPID_SUBJECT must be a mailto: or https: contact for the push services.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
